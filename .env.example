# Server Configuration
PORT=5000
NODE_ENV=production
# Required: a long random string. The server will not start without it.
JWT_SECRET=

# Database Configuration (Hostinger Cloud Hosting Native MySQL)
# Note: Use 127.0.0.1 instead of localhost on Hostinger to prevent IPv6 connection errors
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u123456789_expense_user
DB_PASSWORD=your_secure_db_password
DB_NAME=u123456789_expense_tracker

# Initial Super Admin Credentials (Created only if no users exist in database)
INITIAL_ADMIN_EMAIL=admin@construction.com
# Leave empty in production to get a generated one-time password in the startup log
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_PHONE=+91 98765 43210

# File Uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads/receipts

# WhatsApp Business Cloud API (leave blank to keep bulk sending switched off)
# The template body must have 4 variables, in order: employee name, period, site, net amount
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Client URL (for CORS if running separate dev servers)
CLIENT_URL=http://localhost:5173
