{
  "name": "construction-expense-tracker",
  "version": "1.0.0",
  "description": "Web Based Expense Tracking Platform for a Construction Company hosted on Hostinger Node Apps",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "start": "node server/src/server.js",
    "install:all": "npm install",
    "postinstall": "npm --prefix server install && npm --prefix client install --include=dev"
  },
  "keywords": [
    "construction",
    "expense-tracker",
    "hostinger",
    "express",
    "react",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
